# Copy to .env and replace the placeholder:  Copy-Item .env.example .env
# .env is git-ignored. Never commit real passwords.
POSTGRES_USER=zabbix
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=zabbix
PHP_TZ=Asia/Seoul
# Host ports (127.0.0.1 only). Defaults avoid the app's 8080/8000/8100/5173 and the team VM's 8081/10051.
ZBX_WEB_PORT=18080
ZBX_TRAPPER_PORT=18051
