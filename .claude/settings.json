{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(uv run *)",
      "Bash(uv sync)",
      "Bash(npm run *)",
      "Bash(npm ci)",
      "Bash(npx tsc *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git log*)",
      "Bash(git switch *)",
      "Bash(git checkout -b *)",
      "Bash(git push origin night/*)",
      "Bash(git push origin feat/*)",
      "Bash(docker compose * ps)",
      "Bash(docker compose * logs *)",
      "Bash(docker compose * build *)",
      "Bash(gh issue list*)",
      "Bash(gh issue view *)",
      "Bash(gh issue comment *)",
      "Bash(gh issue create *)",
      "Bash(gh issue edit * --add-label *)",
      "Bash(gh label list*)",
      "Bash(gh pr review *)",
      "Bash(gh pr edit * --add-reviewer *)",
      "Bash(gh pr merge * --auto --squash*)",
      "Bash(git fetch*)",
      "Bash(git merge origin/dev*)",
      "Bash(git worktree *)",
      "Bash(git bisect *)",
      "Bash(git revert --no-edit *)",
      "Bash(git push origin fix/*)",
      "Bash(git push origin docs/*)",
      "Bash(gh pr list*)",
      "Bash(gh pr view *)",
      "Bash(gh pr diff *)",
      "Bash(gh pr checks *)",
      "Bash(gh pr create *)",
      "Bash(gh pr edit * --base dev*)",
      "Bash(gh pr edit * --add-label *)",
      "Bash(gh pr edit * --remove-label ci-failed*)",
      "Bash(gh pr edit * --remove-label conflict*)",
      "Bash(gh run list*)",
      "Bash(gh run view *)",
      "Bash(gh api user*)",
      "Bash(gh issue edit * --add-assignee *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(**/.env)",
      "Edit(./.env)",
      "Edit(**/.env)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push origin main*)",
      "Bash(git push origin dev*)",
      "Bash(git reset --hard*)",
      "Bash(rm -rf*)",
      "Bash(docker system prune*)",
      "Bash(gh issue close*)",
      "Bash(gh issue delete*)",
      "Bash(gh issue edit *--remove-label*needs-human*)",
      "Bash(gh pr merge *--admin*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-env.mjs\"", "timeout": 10 }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-merge.mjs\"", "timeout": 30 }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/format-on-edit.mjs\"", "timeout": 60 }
        ]
      }
    ]
  }
}
