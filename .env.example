# Zabbix (읽기 전용 계정의 API 토큰)
ZABBIX_URL=                       # (TODO: 추후결정 — 후보: http://<VM 호스트 PC IP>:8081/zabbix/api_jsonrpc.php(포트 포워딩), http://<VM 브리지 IP>/zabbix/api_jsonrpc.php) — 11-2
ZABBIX_API_TOKEN=
ZABBIX_VERIFY_TLS=false
ZABBIX_MOCK=false                 # true면 Backend·MCP·Scheduler가 고정 JSON 사용 (3-5)
# 내부 통신
AGENT_URL=http://agent:8100
MCP_ZABBIX_URL=http://mcp-zabbix:8200/mcp
INTERNAL_TOKEN=change-me          # Backend→Agent, Agent→MCP 공유 비밀
# DB
SHARED_DB_PATH=/data/shared.db
BACKEND_DB_PATH=/data/backend.db
# LLM (OpenAI 호환 엔드포인트 → 사내 게이트웨이로 교체 가능)
LLM_BASE_URL=                     # [검토 반영] 공급자 보류 — 빈 값이면 LLM 없이 fallback. 예: https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL=                        # 도구 호출 지원 모델 (TODO: 추후결정)
LLM_FALLBACK_MODEL=
LLM_TIMEOUT_SEC=45
LLM_FAKE=false                    # [검토 반영] true면 가짜 LLM(고정 JSON, 테스트·개발 전용, 데모 금지). 우선순위 4-5
LLM_DAILY_BUDGET_USD=             # 초과 시 fallback 리포트만 생성 (G4) — 예산 (TODO: 추후결정 — 후보: 일 3달러·전체 15달러). 일일 판정은 [선택]
# 도메인 팩
DOMAIN_PACK=it                    # [v1.2] 활성 팩 (변수 이름 TODO: 추후결정 — 후보: DOMAIN_PACK, NFR-EXT-002)
# 메일
MAIL_PROVIDER=console             # console | smtp | sendgrid — .env.example 기본은 console(야간 루프 실발송 방지), 데모 호스트 PC .env만 smtp
MAIL_RECIPIENTS=                  # [필수 단계] 쉼표 구분 수신자. notification_recipients 테이블은 [선택]
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=                    # Gmail 앱 비밀번호
SENDGRID_API_KEY=
MAIL_FROM=                        # 발신 계정 (TODO: 추후결정 — 후보: 새 팀 공용 Gmail)
# 인증
JWT_SECRET=
DEMO_ADMIN_PASSWORD=
DEMO_ONCALL_PASSWORD=
APP_BASE_URL=                     # 메일 본문 링크용. 형식 http://<데모 호스트 PC IP>:8080, 로컬은 http://localhost:5173. 비우면 링크 생략 (TODO: 추후결정 — 후보: 장재현 PC). 값에 공백 금지(uv --env-file 파싱 실패, #83)
# 동작
INCIDENT_POLL_SEC=30              # [검토 반영] 30초로 통일 (v1은 60)
ANALYZE_MIN_SEVERITY=2            # Zabbix 심각도 2(Warning) 이상만 자동 분석
